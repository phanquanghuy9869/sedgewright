<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:orchestrations="using:Sedgewright.ViewModels.Orchestrations.Concurrent"
        mc:Ignorable="d"
        x:Class="Sedgewright.Views.Orchestrations.Concurrent.ConcurrentOrchestrationEditorWindow"
        x:DataType="orchestrations:ConcurrentOrchestrationEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="960"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{DynamicResource CanvasBrush}">
    <Window.Styles>
        <Style Selector="Button.pill-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="CheckBox.participant-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,8,14,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="CheckBox.participant-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

    </Window.Styles>

    <Border Classes="modal-surface">
    <Grid Margin="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <StackPanel x:Name="TitleDragRegion"
                        Spacing="4">
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubtitleText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="✕"
                    Command="{Binding CancelCommand}"
                    Classes="pill-action"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <ScrollViewer Classes="modal-scroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="modal-scroll-content"
                        Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Name"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                             PlaceholderText="parallel-review" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Description"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding Description, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="84"
                             VerticalContentAlignment="Top"
                             PlaceholderText="A compact description of this workflow" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Participants"
                               FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="orchestrations:ConcurrentOrchestrationParticipantSelectionItemViewModel">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Classes="participant-card"
                                          Margin="0,0,5,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <Border IsVisible="{Binding HasValidationText}"
                    Classes="validation-error">
                                <Grid ColumnDefinitions="Auto,*"
                                            ColumnSpacing="8">
                                        <TextBlock Text="!"
                                                             Classes="validation-error-marker" />
                                        <TextBlock Grid.Column="1"
                                                             Text="{Binding ValidationText}"
                                                             Classes="validation-error"
                                                             TextWrapping="Wrap" />
                                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Classes="pill-action" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Classes="pill-action" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
