<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:orchestrations="using:Sedgewright.ViewModels.Orchestrations.Handoff"
        mc:Ignorable="d"
        x:Class="Sedgewright.Views.Orchestrations.Handoff.HandoffOrchestrationEditorWindow"
        x:DataType="orchestrations:HandoffOrchestrationEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="980"
        Height="780"
        MinWidth="860"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{DynamicResource CanvasBrush}">
    <Window.Styles>
        <Style Selector="Button.pill-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="CheckBox.participant-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,8,14,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="CheckBox.participant-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <Style Selector="Border.route-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Window.Styles>

    <Border Classes="modal-surface">
    <Grid Margin="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <StackPanel x:Name="TitleDragRegion"
                        Spacing="4">
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubtitleText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="✕"
                    Command="{Binding CancelCommand}"
                    Classes="pill-action"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <ScrollViewer Classes="modal-scroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="modal-scroll-content"
                        Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Name"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                             PlaceholderText="handoff-workflow" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Description"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding Description, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="84"
                             VerticalContentAlignment="Top"
                             PlaceholderText="A compact description of this workflow" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Start agent"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding AvailableAgents}"
                              SelectedItem="{Binding SelectedStartAgent, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Name}" />
                </StackPanel>

                <CheckBox Content="Autonomous mode"
                          IsChecked="{Binding IsAutonomousModeEnabled, Mode=TwoWay}" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Participants"
                               FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="orchestrations:HandoffOrchestrationParticipantSelectionItemViewModel">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Classes="participant-card"
                                          Margin="0,0,5,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Routes"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Leave the list empty to allow any participant to hand off to any other."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Add route"
                                Command="{Binding AddRouteCommand}"
                                Classes="pill-action" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="orchestrations:HandoffOrchestrationRouteViewModel">
                                <Border Classes="route-card"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="*,*,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Source"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding AvailableAgents}"
                                                      SelectedItem="{Binding SelectedSourceAgent, Mode=TwoWay}"
                                                      DisplayMemberBinding="{Binding Name}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Text="Target"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding AvailableAgents}"
                                                      SelectedItem="{Binding SelectedTargetAgent, Mode=TwoWay}"
                                                      DisplayMemberBinding="{Binding Name}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Remove"
                                                Command="{Binding RemoveCommand}"
                                                Classes="pill-action"
                                                VerticalAlignment="Top" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding Summary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <Border IsVisible="{Binding HasValidationText}"
                    Classes="validation-error">
                                <Grid ColumnDefinitions="Auto,*"
                                            ColumnSpacing="8">
                                        <TextBlock Text="!"
                                                             Classes="validation-error-marker" />
                                        <TextBlock Grid.Column="1"
                                                             Text="{Binding ValidationText}"
                                                             Classes="validation-error"
                                                             TextWrapping="Wrap" />
                                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Classes="pill-action" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Classes="pill-action" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
