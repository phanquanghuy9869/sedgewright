<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Markdown.Avalonia"
             xmlns:models="using:Sedgewright.Models"
             x:Class="Sedgewright.Views.Chat.ChatActivityView"
             x:DataType="models:IntermediateUpdate">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ChatActivityTitleBrush">#79C9E8</SolidColorBrush>
                    <SolidColorBrush x:Key="ChatActivityLinkBrush">#63D9B5</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChatActivityTitleBrush">#075B7A</SolidColorBrush>
                    <SolidColorBrush x:Key="ChatActivityLinkBrush">#006B5E</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChatActivityTitleBrush">#79C9E8</SolidColorBrush>
                    <SolidColorBrush x:Key="ChatActivityLinkBrush">#63D9B5</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Sedgewright/Views/Chat/ChatTypography.axaml" />

        <Style Selector="Button.activity-details">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <Border Margin="0,2,0,4"
            Padding="8,6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="7">
        <Grid ColumnDefinitions="2,*"
              ColumnSpacing="9">
            <Border Background="{DynamicResource ChatActivityLinkBrush}"
                    CornerRadius="1" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActivityTitle}"
                                   Classes="label"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ChatActivityTitleBrush}" />
                        <TextBlock Text="{Binding Source}"
                                   Classes="small"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="activity-details"
                            Content="Show"
                            IsVisible="{Binding HasDetails}"
                            Click="OnShowDetailsClick"
                            ToolTip.Tip="Open full activity details">
                        <Button.Foreground>
                            <DynamicResource ResourceKey="ChatActivityLinkBrush" />
                        </Button.Foreground>
                    </Button>
                </Grid>
                <TextBlock Text="{Binding Update}"
                           IsVisible="{Binding HasStandaloneUpdate}"
                           Classes="chat-body"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="{Binding ProgressSummary}"
                           IsVisible="{Binding HasProgress}"
                           Classes="chat-body"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <md:MarkdownScrollViewer IsVisible="{Binding HasProgress}"
                                         Markdown="{Binding ProgressInstruction}">
                    <md:MarkdownScrollViewer.Styles>
                        <StyleInclude Source="avares://Sedgewright/Views/Chat/ChatMarkdownStyles.axaml" />
                    </md:MarkdownScrollViewer.Styles>
                </md:MarkdownScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
