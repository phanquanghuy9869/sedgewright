<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sedgewright.ViewModels.ProviderModelSelection"
        mc:Ignorable="d"
        x:Class="Sedgewright.Views.ProviderModelSelection.ProviderModelSelectionWindow"
        x:DataType="vm:ProviderModelSelectionViewModel"
        Title="{Binding WindowTitle}"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="14"
        Margin="18">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Choose enabled models"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="Filter the discovered list and keep only the models you want active for this provider."
                   Classes="label"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12"
            VerticalAlignment="Center">
        <TextBox Text="{Binding ModelFilterText, Mode=TwoWay}"
                 PlaceholderText="Filter models"
                 HorizontalAlignment="Stretch" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Content="Enable all"
                  Command="{Binding EnableAllCommand}"
                  MinWidth="110" />
          <Button Content="Disable all"
                  Command="{Binding DisableAllCommand}"
                  MinWidth="110" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{Binding VisibleModelItems}"
                        IsVisible="{Binding HasVisibleModelItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderModelSelectionItemViewModel">
                <CheckBox Content="{Binding ModelId}"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="No models match the current filter."
                     IsVisible="{Binding HasNoVisibleModelItems}"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock Text="Use the filter to narrow a long provider list, then accept the models you want to keep active."
                   Classes="label"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Content="Cancel"
                  Command="{Binding CancelCommand}"
                  MinWidth="92" />
          <Button Content="Keep selection"
                  Command="{Binding AcceptCommand}"
                  MinWidth="132" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
