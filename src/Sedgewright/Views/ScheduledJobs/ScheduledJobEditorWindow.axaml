<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scheduled="using:Sedgewright.ViewModels.ScheduledJobs"
        mc:Ignorable="d"
        x:Class="Sedgewright.Views.ScheduledJobs.ScheduledJobEditorWindow"
        x:DataType="scheduled:ScheduledJobEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{DynamicResource CanvasBrush}">
    <Window.Styles>
        <Style Selector="Button.pill-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Border.field-surface">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Styles>

    <Border Classes="modal-surface">
        <Grid Margin="16"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <StackPanel x:Name="TitleDragRegion"
                            Spacing="4">
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SubtitleText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="X"
                        Command="{Binding CancelCommand}"
                        Classes="pill-action"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Classes="modal-scroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Classes="modal-scroll-content"
                      ColumnDefinitions="0.85*,1.35*"
                      ColumnSpacing="14"
                      RowSpacing="14">
                    <StackPanel Spacing="12">
                        <Border Classes="field-surface">
                            <StackPanel Spacing="10">
                                <TextBlock Text="JOB"
                                           Classes="eyebrow" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Name"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                                             PlaceholderText="Morning report" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Description"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Description, Mode=TwoWay}"
                                             PlaceholderText="Optional" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              OffContent="Paused"
                                              OnContent="Active"
                                              HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Classes="field-surface">
                            <StackPanel Spacing="10">
                                <TextBlock Text="TARGET"
                                           Classes="eyebrow" />
                                <TextBox Text="{Binding TargetFilter, Mode=TwoWay}"
                                         PlaceholderText="Filter agents and orchestrations" />
                                <ListBox ItemsSource="{Binding FilteredTargetOptions}"
                                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                         Height="190"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="scheduled:ScheduledJobTargetOptionViewModel">
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No matching targets. The current selection stays available."
                                           IsVisible="{Binding HasNoTargetMatches}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="12">
                        <Border Classes="field-surface">
                            <StackPanel Spacing="8">
                                <TextBlock Text="PROMPT"
                                           Classes="eyebrow" />
                                <TextBox Text="{Binding Prompt, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="230"
                                         VerticalContentAlignment="Top"
                                         PlaceholderText="Write the prompt the target should receive." />
                            </StackPanel>
                        </Border>

                        <Border Classes="field-surface">
                            <StackPanel Spacing="10">
                                <TextBlock Text="SCHEDULE"
                                           Classes="eyebrow" />
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                    <ComboBox Grid.Column="0"
                                              Width="150"
                                              ItemsSource="{Binding ScheduleKindOptions}"
                                              SelectedItem="{Binding SelectedScheduleKind, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="scheduled:ScheduleKindOptionViewModel">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                IsVisible="{Binding IsIntervalSchedule}">
                                        <TextBlock Text="Every"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBox Text="{Binding IntervalMinutes, Mode=TwoWay}"
                                                 Width="72"
                                                 HorizontalContentAlignment="Center" />
                                        <TextBlock Text="minutes"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="8"
                                            IsVisible="{Binding IsCronSchedule}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Cron expression"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding CronExpression, Mode=TwoWay}"
                                                 PlaceholderText="0 0 9 * * ?" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Time zone"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding TimeZoneId, Mode=TwoWay}"
                                                 PlaceholderText="UTC" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="6"
                                            IsVisible="{Binding IsOnceSchedule}">
                                    <TextBlock Text="Run at"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding RunAtText, Mode=TwoWay}"
                                             PlaceholderText="yyyy-MM-dd HH:mm" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="field-surface">
                            <StackPanel Spacing="6">
                                <TextBlock Text="BOUNDARIES"
                                           Classes="eyebrow" />
                                <TextBlock Text="Start boundary"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <DatePicker SelectedDate="{Binding StartAtDate, Mode=TwoWay}"
                                                MonthFormat="MMM"
                                                DayFormat="dd"
                                                YearFormat="yy"
                                                Width="190" />
                                    <TimePicker SelectedTime="{Binding StartAtTime, Mode=TwoWay}"
                                                ClockIdentifier="24HourClock"
                                                Width="110" />
                                </StackPanel>
                                <TextBlock Text="End boundary"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <DatePicker SelectedDate="{Binding EndAtDate, Mode=TwoWay}"
                                                MonthFormat="MMM"
                                                DayFormat="dd"
                                                YearFormat="yy"
                                                Width="190" />
                                    <TimePicker SelectedTime="{Binding EndAtTime, Mode=TwoWay}"
                                                ClockIdentifier="24HourClock"
                                                Width="110" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <TextBlock Text="{Binding ValidationText}"
                           IsVisible="{Binding HasValidationText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlErrorTextBrush}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Classes="pill-action" />
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Classes="primary" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
