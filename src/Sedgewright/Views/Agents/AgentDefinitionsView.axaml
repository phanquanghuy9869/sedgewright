<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:agents="using:Sedgewright.ViewModels.Agents"
             xmlns:agentViews="using:Sedgewright.Views.Agents"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Sedgewright.Views.Agents.AgentDefinitionsView"
             x:DataType="agents:AgentDefinitionsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.ghost-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.agent-filter">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer IsVisible="{Binding IsListVisible}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,10,14,14"
                        Spacing="12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  VerticalAlignment="Center">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SubtitleText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Classes="ghost-action" />
                    <Button Content="Add agent"
                            Command="{Binding AddCommand}"
                            Classes="primary" />
                </StackPanel>
            </Grid>

            <TextBox Text="{Binding FilterText, Mode=TwoWay}"
                     PlaceholderText="Filter agents"
                     Classes="agent-filter"
                     HorizontalAlignment="Stretch"
                     MinHeight="30" />

            <ItemsControl ItemsSource="{Binding VisibleItems}"
                          IsVisible="{Binding HasVisibleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="agents:AgentDefinitionListItemViewModel">
                        <Border Classes="definition-list-row">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="3">
                                <TextBlock TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12">
                                    <Run Text="{Binding Name}"
                                         FontWeight="SemiBold" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Description}"
                                         FontSize="11"
                                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </TextBlock>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <Button Content="Edit"
                                            Command="{Binding EditCommand}"
                                            Classes="ghost-action" />
                                    <Button Content="Delete"
                                            Command="{Binding DeleteCommand}"
                                            IsEnabled="{Binding CanDelete}"
                                            Classes="ghost-action" />
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding CompactSummary}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding HasNoItems}"
                        Spacing="4"
                        Margin="0,2,0,0">
                <TextBlock Text="{Binding EmptyStateTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding EmptyStateText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNoMatches}"
                        Spacing="4"
                        Margin="0,2,0,0">
                <TextBlock Text="No matching agents."
                           FontWeight="SemiBold" />
                <TextBlock Text="Try a different name, description, provider, or model."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusText}"
                       IsVisible="{Binding HasStatusText}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsEditing}">
            <agentViews:AgentDefinitionEditorView DataContext="{Binding ActiveEditor}" />
        </Grid>
    </Grid>
</UserControl>
