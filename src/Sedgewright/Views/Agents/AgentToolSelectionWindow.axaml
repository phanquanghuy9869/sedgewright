<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:agents="using:Sedgewright.ViewModels.Agents"
        mc:Ignorable="d"
        x:Class="Sedgewright.Views.Agents.AgentToolSelectionWindow"
        x:DataType="agents:AgentToolSelectionViewModel"
        Title="{Binding WindowTitle}"
        Width="560"
        Height="520"
        MinWidth="440"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{DynamicResource CanvasBrush}">
    <Border Classes="modal-surface">
    <Grid Margin="14"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <StackPanel x:Name="TitleDragRegion"
                        Spacing="2">
                <TextBlock Text="Choose tool attachments"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="Select the reusable tools this agent may use."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="✕"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="9,5"
                    CornerRadius="8"
                    MinHeight="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <ScrollViewer Classes="modal-scroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="modal-scroll-content"
                        Spacing="4">
                <ItemsControl ItemsSource="{Binding Items}"
                              IsVisible="{Binding HasItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="agents:AgentToolDefinitionSelectionItemViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,3">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No tool definitions are available."
                           IsVisible="{Binding HasItems, Converter={StaticResource BoolToInverseConverter}}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <TextBlock Text="Selections are saved with the agent."
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="10,6"
                        CornerRadius="8"
                        MinHeight="0" />
                <Button Content="Apply"
                        Command="{Binding ApplyCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="10,6"
                        CornerRadius="8"
                        MinHeight="0" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
