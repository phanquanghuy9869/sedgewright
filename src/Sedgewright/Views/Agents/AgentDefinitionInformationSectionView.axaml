<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:agents="using:Sedgewright.ViewModels.Agents"
             xmlns:markdown="using:ProMarkdown.Controls"
             xmlns:markdownServices="using:ProMarkdown.Services"
             mc:Ignorable="d"
             x:Class="Sedgewright.Views.Agents.AgentDefinitionInformationSectionView"
             x:DataType="agents:AgentDefinitionInformationViewModel">
    <UserControl.Styles>
        <Style Selector="ToggleButton.prompt-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ToggleButton.prompt-toggle:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
            <TextBlock Text="System prompt"
                       FontWeight="SemiBold"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SystemPromptCharacterCount}"
                           FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="characters"
                           FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <ToggleButton Grid.Column="2"
                          Classes="prompt-toggle"
                          Content="{Binding PromptModeToggleText}"
                          IsChecked="{Binding IsPromptPreviewMode, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="1">
            <TextBox Text="{Binding SystemPrompt, Mode=TwoWay}"
                     IsVisible="{Binding IsPromptEditMode}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     PlaceholderText="You are a focused assistant..." />

            <Border IsVisible="{Binding IsPromptPreviewMode}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid>
                    <TextBlock Text="Nothing to preview yet. Switch to Edit and write the system prompt."
                               IsVisible="{Binding !HasSystemPrompt}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />

                    <ScrollViewer IsVisible="{Binding HasSystemPrompt}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <markdown:MarkdownTextBlock Markdown="{Binding SystemPrompt}"
                                                    ImageOptions="{x:Static markdownServices:MarkdownImageOptions.EmbeddedOnly}"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    FontSize="13"
                                                    TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
