<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:agents="using:Sedgewright.ViewModels.Agents"
             mc:Ignorable="d"
             x:Class="Sedgewright.Views.Agents.AgentDefinitionHarnessOptionsSectionView"
             x:DataType="agents:AgentDefinitionHarnessOptionsViewModel">
    <StackPanel Spacing="5">
          <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <CheckBox Content="Harness agent"
                      IsChecked="{Binding IsHarnessAgent, Mode=TwoWay}"
                      IsEnabled="{Binding CanToggleHarnessAgentType}"
                      VerticalAlignment="Center" />

                <Button Grid.Column="1"
                    Command="{Binding OpenHarnessOptionsCommand}"
                    Classes="editor-action"
                    IsVisible="{Binding IsHarnessAgent}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                        Spacing="6">
                    <TextBlock Text="Harness options"
                           FontWeight="SemiBold"
                           FontSize="11" />
                    <TextBlock Text="{Binding HarnessSummary}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
                </Button>
        </Grid>
    </StackPanel>
</UserControl>
