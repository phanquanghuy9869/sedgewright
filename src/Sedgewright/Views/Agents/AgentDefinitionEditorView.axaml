<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:agents="using:Sedgewright.ViewModels.Agents"
             xmlns:agentViews="using:Sedgewright.Views.Agents"
             mc:Ignorable="d"
             x:Class="Sedgewright.Views.Agents.AgentDefinitionEditorView"
             x:DataType="agents:AgentDefinitionEditorViewModel">
    <UserControl.Styles>
        <Style Selector="Button.pill-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Button.editor-action">
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.editor-action:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="CheckBox.harness-option">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="16,10"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubtitleText}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="‹ Agent definitions"
                    Command="{Binding CancelCommand}"
                    Classes="pill-action"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,340"
              ColumnSpacing="16">
            <agentViews:AgentDefinitionInformationSectionView DataContext="{Binding Information}" />

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12"
                            Margin="0,0,6,0">
                    <agentViews:AgentDefinitionIdentitySectionView DataContext="{Binding Information}" />
                    <agentViews:AgentDefinitionProviderModelSectionView DataContext="{Binding ProviderModel}" />
                    <agentViews:AgentDefinitionMcpAttachmentsSectionView DataContext="{Binding McpAttachments}" />
                    <agentViews:AgentDefinitionToolsSectionView DataContext="{Binding Tools}" />
                    <agentViews:AgentDefinitionSkillsSectionView x:Name="SkillsSection"
                                                                 DataContext="{Binding Skills}" />
                    <agentViews:AgentDefinitionShellSectionView DataContext="{Binding Shell}" />
                    <agentViews:AgentDefinitionHarnessOptionsSectionView DataContext="{Binding HarnessOptions}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <StackPanel Spacing="2"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ValidationText}"
                           Classes="validation-error"
                           IsVisible="{Binding HasValidationText}"
                           TextWrapping="Wrap"
                           FontSize="11" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Classes="pill-action" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Classes="pill-action" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
